# Copy to /etc/ifx-test.env on the VM.
# The service runs as user <web-user>; keep this file mode 640 root:<web-user>.
# Do not commit the real password or real server/database names.

INFORMIXDIR=/opt/ibm/informix
INFORMIXSERVER=example_server
INFORMIXSQLHOSTS=/path/to/sqlhosts

IFX_TEST_HOST=db.example.invalid
IFX_TEST_PORT=9088
IFX_TEST_SERVER=example_server
IFX_TEST_DATABASE=example_db
IFX_TEST_USER=example_user
IFX_TEST_PASSWORD=<password>

# Optional; needed when the direct ifx driver cannot resolve sqlhosts.
IFX_TEST_IFX_DSN=informix:server=example_server;database=example_db;host=db.example.invalid;service=9088;protocol=olsoctcp;
